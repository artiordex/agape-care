{
  "name": "@agape-care/api",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["type:app", "layer:backend", "platform:node"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "outputs": ["{workspaceRoot}/dist/apps/api"],
      "options": {
        "command": "nest build && node -e \"const fs=require('fs');const path=require('path');const src=path.resolve('../../dist/apps/api/src');const dst=path.resolve('../../dist/apps/api');if(fs.existsSync(src)){for(const name of fs.readdirSync(src)){fs.cpSync(path.join(src,name),path.join(dst,name),{recursive:true,force:true});}fs.rmSync(src,{recursive:true,force:true});}\"",
        "cwd": "apps/api"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "options": {
        "command": "nest start --watch",
        "cwd": "apps/api"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": ["apps/api/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vite:test",
      "options": {
        "vitestConfig": "../../vitest.config.ts",
        "passWithNoTests": true
      },
      "outputs": ["{workspaceRoot}/coverage/apps/api"]
    }
  },
  "implicitDependencies": ["@agape-care/database", "@agape-care/logger", "@agape-care/api-contract"]
}
