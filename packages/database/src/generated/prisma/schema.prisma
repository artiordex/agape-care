  /// 수정일시
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// 계정 분류
  category AccountCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// 이 계정으로 처리된 거래 내역들
  items    TransactionItem[]

  @@map("accounts")
}

/// 거래처 (공급업체)
model Supplier {
  /// 거래처 ID (Primary Key)
  id          BigInt   @id @default(autoincrement())
  /// 거래처명
  name        String
