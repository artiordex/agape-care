generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["views"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// WEB 알림마당
// ============================================================================

// 공지사항
model Notice {
  /// 공지 ID (Primary Key)
  id          BigInt       @id @default(autoincrement())
  /// 공지 제목
  title       String
  /// 공지 내용 (HTML)
  content     String
  /// 카테고리 (GENERAL, URGENT, EVENT, EDUCATION, MAINTENANCE 등)
  category    String?      @default("GENERAL")
  /// 상단 고정 여부
  isPinned    Boolean      @default(false) @map("is_pinned")
  /// 활성화 여부
  isActive    Boolean      @default(true) @map("is_active")
  /// 조회수
  viewCount   Int          @default(0) @map("view_count")
  /// 게시일시
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(6)
  /// 작성자 ID (외래키)
  createdBy   BigInt?      @map("created_by")
  /// 생성일시
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  files       NoticeFile[]
  creator     Employee?    @relation("NoticeCreator", fields: [createdBy], references: [id], onUpdate: NoAction)

  @@index([isActive, publishedAt(sort: Desc)], map: "idx_notices_active")
  @@index([isPinned(sort: Desc), createdAt(sort: Desc)], map: "idx_notices_pinned")
  @@map("notices")
}

// 공지사항 - 첨부 파일
model NoticeFile {
  /// 연결 ID (Primary Key)
  id        BigInt      @id @default(autoincrement())
  /// 공지 ID
  noticeId  BigInt      @map("notice_id")
  /// 파일 ID
  fileId    BigInt      @map("file_id")
  /// 생성일시
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  file      FileStorage @relation("NoticeFiles", fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  notice    Notice      @relation(fields: [noticeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("notice_files")
}

// 게시판 - 게시글
model BoardPost {
  /// 게시글 ID (Primary Key)
  id        BigInt         @id @default(autoincrement())
  /// 게시판 구분 키
  boardKey  String         @map("board_key")
  /// 게시글 제목
  title     String
  /// 게시글 내용
  content   String
  /// 작성자 ID
  authorId  BigInt?        @map("author_id")
  /// 조회수
  viewCount Int            @default(0) @map("view_count")
  /// 상단 고정 여부 (공지형 게시글 등)
  isPinned  Boolean        @default(false) @map("is_pinned")
  /// 댓글 잠금 여부 (댓글 작성 불가 처리)
  isLocked  Boolean        @default(false) @map("is_locked")
  /// 생성일시
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  comments  BoardComment[]
  files     BoardFile[]
  author    Employee?      @relation(fields: [authorId], references: [id], onUpdate: NoAction)

  @@index([authorId], map: "idx_board_posts_author")
  @@index([boardKey, createdAt(sort: Desc)], map: "idx_board_posts_board_created")
  @@index([isPinned(sort: Desc), createdAt(sort: Desc)], map: "idx_board_posts_pinned")
  @@map("board_posts")
}

// 게시판 - 첨부 파일
model BoardFile {
  /// 연결 ID
  id        BigInt      @id @default(autoincrement())
  /// 게시글 ID
  postId    BigInt      @map("post_id")
  /// 파일 ID
  fileId    BigInt      @map("file_id")
  /// 생성일시
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  file      FileStorage @relation("BoardFiles", fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  post      BoardPost   @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("board_files")
}

// 게시판 - 댓글
model BoardComment {
  /// 댓글 ID
  id        BigInt         @id @default(autoincrement())
  /// 게시글 ID
  postId    BigInt         @map("post_id")
  /// 부모 댓글 ID (대댓글인 경우, 외래키)
  parentId  BigInt?        @map("parent_id")
  /// 작성자 ID
  authorId  BigInt?        @map("author_id")
  /// 댓글 내용
  content   String
  /// 삭제 여부
  isDeleted Boolean        @default(false) @map("is_deleted")
  /// 생성일시
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  author    Employee?      @relation(fields: [authorId], references: [id], onUpdate: NoAction)
  parent    BoardComment?  @relation("BoardCommentParent", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  replies   BoardComment[] @relation("BoardCommentParent")
  post      BoardPost      @relation(fields: [postId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("board_comments")
}

// 갤러리 - 항목 (사진첩)
model GalleryItem {
  /// 갤러리 항목 ID (Primary Key)
  id          BigInt        @id @default(autoincrement())
  /// 제목
  title       String?
  /// 설명
  description String?
  /// 카테고리 (행사, 일상 등)
  category    String?       @default("GENERAL")
  /// 행사 일자
  eventDate   DateTime?     @map("event_date") @db.Date
  /// 작성자 ID (외래키)
  createdBy   BigInt?       @map("created_by")
  /// 공개 여부
  isPublic    Boolean       @default(true) @map("is_public")
  /// 생성일시
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  files       GalleryFile[]
  creator     Employee?     @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@index([eventDate(sort: Desc)], map: "idx_gallery_items_date")
  @@index([isPublic], map: "idx_gallery_items_public")
  @@map("gallery_items")
}

// 갤러리 - 파일
model GalleryFile {
  /// 연결 ID (Primary Key)
  id        BigInt      @id @default(autoincrement())
  /// 갤러리 ID
  galleryId BigInt      @map("gallery_id")
  /// 파일 ID
  fileId    BigInt      @map("file_id")
  /// 정렬 순서
  sortOrder Int         @default(0) @map("sort_order")
  /// 생성일시
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  file      FileStorage @relation("GalleryFiles", fields: [fileId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  gallery   GalleryItem @relation(fields: [galleryId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("gallery_files")
}

// 식단표
model MealPlan {
  /// 식단표 ID
  id               BigInt         @id @default(autoincrement())
  /// 시설 코드
  facilityCode     String         @default("DEFAULT") @map("facility_code")
  week_start_date  DateTime       @db.Date
  /// 식단 대상 월 (YYYYMM)
  mealMonth        Int            @default(202601) @map("meal_month")
  /// 작성자 ID
  createdBy        BigInt?        @map("created_by")
  /// 영양 관리자
  nutritionManager String?        @map("nutrition_manager")
  /// 상태 (DRAFT, PUBLISHED 등)
  status           String         @default("DRAFT")
  /// 비고/특이사항
  notes            String?
  /// 생성일시
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  mealPlanItems    MealPlanItem[] @relation("MealPlanItems")
  creator          Employee?      @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@unique([facilityCode, week_start_date], map: "meal_plans_uniq_week")
  @@map("meal_plans")
}

/// 식단 상세 항목 (정규화된 데이터)
model MealPlanItem {
  /// 항목 ID (Primary Key)
  id         BigInt   @id @default(autoincrement())
  /// 식단표 ID (외래키)
  mealPlanId BigInt   @map("meal_plan_id")
  /// 식사 날짜
  mealDate   DateTime @map("meal_date") @db.Date
  /// 식사 유형 (BREAKFAST, LUNCH, DINNER, SNACK)
  mealType   String   @map("meal_type")
  /// 주 메뉴
  mainMenu   String?  @map("main_menu")
  /// 부 메뉴
  sideMenu   String?  @map("side_menu")
  /// 국/찌개
  soup       String?
  /// 디저트/김치
  dessert    String?
  /// 생성일시
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  mealPlan   MealPlan @relation("MealPlanItems", fields: [mealPlanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("meal_plan_items")
}

/// 프로그램
model Program {
  /// 프로그램 ID (Primary Key)
  id          BigInt            @id @default(autoincrement())
  /// 프로그램명
  title       String
  /// 프로그램 설명
  description String?
  /// 카테고리
  category    String?
  /// 활성화 여부
  isActive    Boolean           @default(true) @map("is_active")
  /// 생성자 ID
  createdBy   BigInt?           @map("created_by")
  /// 추가 메타데이터 (JSON)
  meta        Json              @default("{}")
  /// 생성일시
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedules   ProgramSchedule[]
  creator     Employee?         @relation(fields: [createdBy], references: [id], onUpdate: NoAction)

  @@index([isActive], map: "idx_programs_active")
  @@index([category], map: "idx_programs_category")
  @@map("programs")
}

/// 프로그램 일정
model ProgramSchedule {
  /// 일정 ID (Primary Key)
  id         BigInt              @id @default(autoincrement())
  /// 프로그램 ID (외래키)
  programId  BigInt              @map("program_id")
  /// 시작일시
  startsAt   DateTime            @map("starts_at") @db.Timestamptz(6)
  /// 종료일시
  endsAt     DateTime            @map("ends_at") @db.Timestamptz(6)
  /// 장소
  location   String?
  /// 정원
  capacity   Int?
  /// 상태 (PLANNED, ONGOING, COMPLETED, CANCELLED)
  status     String              @default("PLANNED")
  /// 생성일시
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt  DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendance ProgramAttendance[]
  program    Program             @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([programId, startsAt], map: "idx_program_schedules_program_time")
  @@map("program_schedules")
}

/// 부서 정보
model Department {
  /// 부서 ID (Primary Key)
  id          BigInt     @id @default(autoincrement())
  /// 부서 코드 (고유값)
  code        String     @unique
  /// 부서명
  name        String
  /// 부서 설명
  description String?
  /// 활성화 여부
  isActive    Boolean    @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees   Employee[]

  @@map("departments")
}

/// 직원 역할/권한 정보
model EmployeeRole {
  /// 역할 ID (Primary Key)
  id          BigInt     @id @default(autoincrement())
  /// 역할 코드 (고유값)
  code        String     @unique
  /// 역할명
  name        String
  /// 역할 설명
  description String?
  /// 권한 설정 (JSON)
  permissions Json       @default("{}")
  /// 생성일시
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employees   Employee[]

  @@map("employee_roles")
}

/// 직원 정보
model Employee {
  /// 직원 ID (Primary Key)
  id                           BigInt                  @id @default(autoincrement())
  /// 부서 ID (외래키)
  departmentId                 BigInt?                 @map("department_id")
  /// 역할 ID (외래키)
  roleId                       BigInt?                 @map("role_id")
  /// 이메일 (로그인 ID, 고유값, 대소문자 구분 안함)
  email                        String?                 @unique @db.Citext
  /// 비밀번호 해시
  passwordHash                 String?                 @map("password_hash")
  /// 직원명
  name                         String
  /// 전화번호
  phoneNumber                  String?                 @map("phone_number")
  /// 입사일
  hireDate                     DateTime?               @map("hire_date") @db.Date
  /// 퇴사일
  resignDate                   DateTime?               @map("resign_date") @db.Date
  /// 재직 상태 (ACTIVE, RESIGNED 등)
  status                       String                  @default("ACTIVE")
  /// 관리자 여부
  isAdmin                      Boolean                 @default(false) @map("is_admin")
  /// 추가 메타데이터 (JSON)
  meta                         Json                    @default("{}")
  /// 마지막 로그인 일시
  lastLoginAt                  DateTime?               @map("last_login_at") @db.Timestamptz(6)
  /// 생성일시
  createdAt                    DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt                    DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  attendanceRecords            AttendanceRecord[]
  auditLogsAsActor             AuditLog[]              @relation("AuditActor")
  boardCommentsAuthored        BoardComment[]
  boardPostsAuthored           BoardPost[]
  carePlansCreated             CarePlan[]              @relation("CarePlanCreator")
  careTasksAssigned            CareTask[]              @relation("CareTaskAssignee")
  cctvViewLogsApproved         CctvViewLog[]           @relation("CctvApprover")
  cctvViewLogsAsViewer         CctvViewLog[]           @relation("CctvViewer")
  consultationsCounseled       ConsultationRecord[]    @relation("ConsultationCounselor")
  educations                   EmployeeEducation[]
  department                   Department?             @relation(fields: [departmentId], references: [id], onUpdate: NoAction)
  role                         EmployeeRole?           @relation(fields: [roleId], references: [id], onUpdate: NoAction)
  inspectionsPerformed         FacilityInspection[]    @relation("InspectionInspector")
  filesCreated                 FileStorage[]           @relation("FileCreator")
  galleryItemsCreated          GalleryItem[]
  grievancesAssigned           Grievance[]             @relation("GrievanceAssignee")
  incidentsReported            Incident[]              @relation("IncidentReporter")
  insuranceClaimHistoryChanged InsuranceClaimHistory[]
  insuranceClaimsCreated       InsuranceClaim[]
  inventoryTransactionsCreated InventoryTransaction[]
  leaveApprovalsGiven          LeaveApproval[]
  leaveRequests                LeaveRequest[]
  mealPlansCreated             MealPlan[]
  noticesCreated               Notice[]                @relation("NoticeCreator")
  payrollRecords               PayrollRecord[]
  popupBannersCreated          PopupBanner[]
  programAttendance            ProgramAttendance[]
  programsCreated              Program[]
  healthNotesRecorded          ResidentHealthNote[]    @relation("HealthNoteRecorder")
  vitalsRecorded               ResidentVital[]         @relation("VitalRecorder")
  shiftAssignments             ShiftAssignment[]
  smsLogsSent                  SmsSendLog[]
  transactionsCreated          Transaction[]
  transportRequestsCreated     TransportRequest[]      @relation("TransportCreator")
  transportRequestsAsDriver    TransportRequest[]      @relation("TransportDriver")
  websiteSettingsUpdated       WebsiteSetting[]        @relation("SettingUpdater")

  @@index([departmentId], map: "idx_employees_department")
  @@index([email], map: "idx_employees_email")
  @@index([roleId], map: "idx_employees_role")
  @@index([status], map: "idx_employees_status")
  @@map("employees")
}

/// 직원 교육 이력
model EmployeeEducation {
  /// 교육 이력 ID (Primary Key)
  id               BigInt   @id @default(autoincrement())
  /// 직원 ID (외래키)
  employeeId       BigInt   @map("employee_id")
  /// 교육 일자
  educationDate    DateTime @map("education_date") @db.Date
  /// 교육명
  title            String
  /// 교육 카테고리
  category         String?
  /// 교육 시간 (시간)
  durationHours    Decimal? @map("duration_hours") @db.Decimal(4, 1)
  /// 강사명
  instructor       String?
  /// 이수 상태
  completionStatus String   @default("COMPLETED") @map("completion_status")
  /// 비고
  notes            String?
  /// 생성일시
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId, educationDate(sort: Desc)], map: "idx_employee_educations_employee")
  @@map("employee_educations")
}

/// 입소자 정보
model Resident {
  /// 입소자 ID (Primary Key)
  id                BigInt               @id @default(autoincrement())
  /// 입소자 코드 (고유값)
  code              String               @unique
  /// 입소자명
  name              String
  /// 생년월일
  birthday          DateTime?            @db.Date
  /// 성별
  gender            String?
  /// 주민등록번호 해시
  nationalIdHash    String?              @map("national_id_hash")
  /// 입소일
  admissionDate     DateTime?            @map("admission_date") @db.Date
  /// 퇴소일
  dischargeDate     DateTime?            @map("discharge_date") @db.Date
  /// 입소 상태 (ADMITTED, DISCHARGED 등)
  status            String               @default("ADMITTED")
  /// 보호자명
  guardianName      String?              @map("guardian_name")
  /// 보호자 연락처
  guardianPhone     String?              @map("guardian_phone")
  /// 메모
  memo              String?
  /// 추가 메타데이터 (JSON)
  meta              Json                 @default("{}")
  /// 생성일시
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt         DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  carePlans         CarePlan[]
  careTasks         CareTask[]
  consultations     ConsultationRecord[]
  dailyCareRecords  DailyCareRecord[]
  grievances        Grievance[]
  incidents         Incident[]
  insuranceClaims   InsuranceClaim[]
  invoices          InvoiceHeader[]
  programAttendance ProgramAttendance[]
  contacts          ResidentContact[]
  healthNotes       ResidentHealthNote[]
  medications       ResidentMedication[]
  rooms             ResidentRoom[]
  vitals            ResidentVital[]
  transportRequests TransportRequest[]

  @@index([admissionDate(sort: Desc)], map: "idx_residents_admission")
  @@index([name], map: "idx_residents_name")
  @@index([status], map: "idx_residents_status")
  @@map("residents")
}

/// 입소자 방/침대 배정 이력
model ResidentRoom {
  /// 배정 ID (Primary Key)
  id         BigInt    @id @default(autoincrement())
  /// 입소자 ID (외래키)
  residentId BigInt    @map("resident_id")
  /// 방 번호/라벨
  roomLabel  String    @map("room_label")
  /// 침대 번호/라벨
  bedLabel   String?   @map("bed_label")
  /// 배정 시작일
  startsAt   DateTime  @map("starts_at") @db.Date
  /// 배정 종료일
  endsAt     DateTime? @map("ends_at") @db.Date
  /// 주 배정 여부
  isPrimary  Boolean   @default(true) @map("is_primary")
  /// 생성일시
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resident   Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([residentId, startsAt], map: "idx_resident_rooms_resident")
  @@map("resident_rooms")
}

/// 입소자 연락처 (보호자 등)
model ResidentContact {
  /// 연락처 ID (Primary Key)
  id           BigInt   @id @default(autoincrement())
  /// 입소자 ID (외래키)
  residentId   BigInt   @map("resident_id")
  /// 연락처 이름
  name         String
  /// 관계 (자녀, 배우자 등)
  relationship String?
  /// 전화번호
  phoneNumber  String?  @map("phone_number")
  /// 주 연락처 여부
  isPrimary    Boolean  @default(false) @map("is_primary")
