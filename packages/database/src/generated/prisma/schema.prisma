  @@index([inspectionDate(sort: Desc)], map: "idx_facility_inspections_date")
  @@index([status], map: "idx_facility_inspections_status")
  @@index([inspectionType], map: "idx_facility_inspections_type")
  @@map("facility_inspections")
}

/// SMS 발송 로그
model SmsSendLog {
  /// 로그 ID (Primary Key)
  id             BigInt    @id @default(autoincrement())
  /// 수신자 전화번호
  recipientPhone String    @map("recipient_phone")
  /// 수신자 이름
  recipientName  String?   @map("recipient_name")
  /// 메시지 내용
  message        String
  /// 발송 유형 (SINGLE, BULK, SCHEDULED)
  sendType       String    @map("send_type")
  /// 예약 발송 시각
  scheduledAt    DateTime? @map("scheduled_at") @db.Timestamptz(6)
  /// 실제 발송 시각
  sentAt         DateTime? @map("sent_at") @db.Timestamptz(6)
  /// 발송 상태 (PENDING, SUCCESS, FAILED)
  status         String    @default("PENDING")
  /// 오류 메시지
  errorMessage   String?   @map("error_message")
  /// SMS 건수 (장문 시 2건 이상)
  smsCount       Int       @default(1) @map("sms_count")
  /// 발송 비용
  cost           Decimal?  @db.Decimal(10, 2)
  /// 결과 코드
  resultCode     String?   @map("result_code")
  /// 발송자 ID (외래키)
  senderId       BigInt?   @map("sender_id")
  /// 생성일시
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sender         Employee? @relation(fields: [senderId], references: [id], onUpdate: NoAction)

  @@index([recipientPhone], map: "idx_sms_send_logs_recipient")
  @@index([sentAt(sort: Desc)], map: "idx_sms_send_logs_sent")
  @@index([status, scheduledAt(sort: Desc)], map: "idx_sms_send_logs_status_scheduled")
  @@map("sms_send_logs")
}

/// 파일 저장소 (S3, 로컬 등)
model FileStorage {
  /// 파일 ID (Primary Key)
  id                BigInt             @id @default(autoincrement())
  /// 저장소 버킷
  bucket            String             @default("default")
  /// 파일 경로
  path              String
  /// 원본 파일명
  originalName      String?            @map("original_name")
  /// MIME 타입
  mimeType          String?            @map("mime_type")
  /// 파일 크기 (바이트)
  sizeBytes         BigInt?            @map("size_bytes")
  /// 체크섬 (MD5, SHA256 등)
  checksum          String?
  /// 업로드자 ID (외래키)
  createdBy         BigInt?            @map("created_by")
  /// 생성일시
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  boardFiles        BoardFile[]        @relation("BoardFiles")
  consultationFiles ConsultationFile[] @relation("ConsultationFiles")
  creator           Employee?          @relation("FileCreator", fields: [createdBy], references: [id], onUpdate: NoAction)
  galleryFiles      GalleryFile[]      @relation("GalleryFiles")
  incidentFiles     IncidentFile[]     @relation("IncidentFiles")
  noticeFiles       NoticeFile[]       @relation("NoticeFiles")

  @@unique([bucket, path], map: "uq_file_storage_bucket_path")
  @@index([createdAt(sort: Desc)], map: "idx_file_storage_created_at")
  @@index([createdBy], map: "idx_file_storage_created_by")
  @@map("file_storage")
}

/// ===============================
/// 감사 로그 (Audit Log)
/// - 시스템 내 모든 주요 변경 이력을 기록
/// - 누가(actor) 언제 무엇을(action) 어떤 엔티티에 대해 수행했는지 추적
/// ===============================
model AuditLog {
  /// 로그 ID (Primary Key)
  id         BigInt    @id @default(autoincrement())
  /// 작업을 수행한 사용자 ID (Employee.id 참조)
  /// 시스템 작업일 경우 NULL 가능
  actorId    BigInt?   @map("actor_id")
  /// 수행된 작업 유형
  /// 예: CREATE, UPDATE, DELETE, LOGIN 등
  action     String
  /// 변경 대상 엔티티 타입 (테이블명 또는 도메인명)
  /// 예: Employee, Reservation, Payment
  entityType String?   @map("entity_type")
  /// 변경 대상 엔티티의 ID
  entityId   BigInt?   @map("entity_id")
  /// 변경 내용 (이전/이후 값 등)
  /// 구조는 서비스 로직에서 자유롭게 정의
  changes    Json?
  /// 요청 발생 IP 주소
  ipAddress  String?   @map("ip_address")
  /// 사용자 브라우저 / 디바이스 정보
  userAgent  String?   @map("user_agent")
  /// 로그 생성 시각
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      Employee? @relation("AuditActor", fields: [actorId], references: [id], onUpdate: NoAction)

  @@index([actorId, createdAt(sort: Desc)], map: "idx_audit_logs_actor")
  @@index([createdAt(sort: Desc)], map: "idx_audit_logs_created")
  @@index([entityType, entityId], map: "idx_audit_logs_entity")
  @@map("audit_logs")
}

/// ===============================
/// 시스템 설정 (Key-Value 기반)
/// - 운영 중 변경 가능한 설정값 저장
/// - 캐시 or 관리자 페이지에서 주로 사용
/// ===============================
model SystemSetting {
  /// 설정 키 (Primary Key)
  /// 예: "MAX_RESERVATION_COUNT", "ENABLE_SMS"
  key         String   @id
  /// 설정 값 (JSON 형태)
  /// 숫자, 문자열, 객체 등 유연하게 저장 가능
  value       Json
  /// 설정에 대한 설명
  description String?
  /// 마지막 수정 시각
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("system_settings")
}

/// ===============================
/// 알림 발송 큐
/// - 이메일, SMS, 푸시 알림 등 비동기 발송 관리
/// - 실패/재시도 처리에 활용
/// ===============================
model NotificationQueue {
  /// 알림 ID (Primary Key)
  id           BigInt    @id @default(autoincrement())
  /// 발송 채널
  /// 예: EMAIL, SMS, PUSH
  channel      String
  /// 알림 대상 타입
  /// 예: EMPLOYEE, USER, ADMIN
  targetType   String    @map("target_type")
  /// 알림 대상 ID
  targetId     BigInt?   @map("target_id")
  /// 알림 제목
  title        String?
  /// 알림 본문
  body         String?
  /// 채널별 추가 데이터
  /// 예: 템플릿 변수, 딥링크 정보
  payload      Json      @default("{}")
  /// 발송 예정 시각
  scheduledAt  DateTime  @default(now()) @map("scheduled_at") @db.Timestamptz(6)
  /// 실제 발송 완료 시각
  sentAt       DateTime? @map("sent_at") @db.Timestamptz(6)
  /// 발송 상태
  /// PENDING, SENT, FAILED
  status       String    @default("PENDING")
  /// 발송 실패 시 에러 메시지
  errorMessage String?   @map("error_message")
  /// 큐에 등록된 시각
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status, scheduledAt], map: "idx_notification_queue_status_sched")
  @@map("notification_queue")
}

/// ===============================
/// 면회 예약
/// - 홈페이지 면회 예약 신청 관리
/// ===============================
model VisitReservation {
  /// 예약 ID (Primary Key)
  id                    BigInt   @id @default(autoincrement())
  /// 방문자 성함
  visitorName           String   @map("visitor_name")
  /// 방문자 연락처
  visitorPhone          String   @map("visitor_phone")
  /// 어르신과의 관계
  visitorRelationship   String   @map("visitor_relationship")
  /// 어르신 성함
  residentName          String   @map("resident_name")
  /// 방문 희망일
  visitDate             DateTime @map("visit_date") @db.Date
  /// 방문 희망시간
  visitTime             String   @map("visit_time")
  /// 방문 인원
  visitorCount          Int      @default(1) @map("visitor_count")
  /// 방문 목적
  visitPurpose          String?  @map("visit_purpose")
  /// 감염 증상 여부 (발열, 기침 등)
  healthCheckSymptoms   Boolean  @default(false) @map("health_check_symptoms")
  /// 이동 보조 필요 여부
  healthCheckAssistance Boolean  @default(false) @map("health_check_assistance")
  /// 추가 요청사항
  notes                 String?
  /// 개인정보 수집 동의 여부
  isConsented           Boolean  @default(false) @map("is_consented")
  /// 처리 상태 (PENDING, APPROVED, REJECTED, CANCELLED)
  status                String   @default("PENDING")
  /// 신청 IP 주소
  ipAddress             String?  @map("ip_address")
  /// 사용자 브라우저 정보
  userAgent             String?  @map("user_agent")
  /// 신청 시각
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정 시각
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("visit_reservations")
}

/// ===============================
/// 웹사이트 상담 문의
/// - 홈페이지 상담 신청 접수용
/// - 관리자 페이지에서 처리 상태 관리
/// ===============================
model WebInquiry {
  /// 문의 ID (Primary Key)
  id            BigInt    @id @default(autoincrement())
  /// 상담자 이름
  name          String
  /// 상담자 연락처
  phone         String
  /// 이메일
  email         String?
  /// 문의 유형
  /// 입소 상담, 비용 상담, 방문 상담, 기타
  type          String
  /// 어르신 연령
  residentAge   String?   @map("resident_age")
  /// 장기요양등급
  careGrade     String?   @map("care_grade")
  /// 방문 상담 희망일
  preferredDate DateTime? @map("preferred_date") @db.Date
  /// 상세 문의사항
  message       String?
  /// 개인정보 수집 동의 여부
  isConsented   Boolean   @default(false) @map("is_consented")
  /// 처리 상태
  /// PENDING: 접수, IN_PROGRESS: 상담중, DONE: 완료, CANCELLED: 취소
  status        String    @default("PENDING")
  /// 문의 접수 IP 주소
  ipAddress     String?   @map("ip_address")
  /// 사용자 브라우저 정보
  userAgent     String?   @map("user_agent")
  /// 문의 생성 시각
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정 시각
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("web_inquiries")
}

