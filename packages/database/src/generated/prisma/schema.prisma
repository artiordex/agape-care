  createdAt        DateTime @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @map("updated_at") @db.Timestamptz(6)
  creatorName      String?  @map("creator_name")
  creatorId        BigInt?  @map("creator_id")
  weekMeals        Json     @map("week_meals")

  @@map("v_web_meal_plans")
}

/// 최신 콘텐츠 통합 조회 뷰
view WebLatestContent {
  id           BigInt   @unique
  contentType  String   @map("content_type")
  title        String
  summary      String?
  createdAt    DateTime @map("created_at") @db.Timestamptz(6)
  viewCount    Int      @map("view_count")
  commentCount Int?     @map("comment_count")
  fileCount    Int      @map("file_count")
  authorName   String?  @map("author_name")

  @@map("v_web_latest_contents")
}
