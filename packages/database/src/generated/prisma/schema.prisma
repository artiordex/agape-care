/// 재고 품목
model InventoryItem {
  /// 품목 ID (Primary Key)
  id              BigInt   @id @default(autoincrement())
  /// 품목 코드 (고유값)
  code            String   @unique
  /// 품목명
  name            String
  /// 카테고리 (의약품, 소모품, 식자재 등)
  category        String
  /// 단위 (개, 박스, kg 등)
  unit            String
  /// 현재 재고량
  currentStock    Decimal  @default(0) @map("current_stock") @db.Decimal(10, 2)
  /// 최소 재고량
  minStock        Decimal? @map("min_stock") @db.Decimal(10, 2)
  /// 최대 재고량
  maxStock        Decimal? @map("max_stock") @db.Decimal(10, 2)
  /// 단가
  unitPrice       Decimal? @map("unit_price") @db.Decimal(14, 2)
  /// 보관 위치
  storageLocation String?  @map("storage_location")
  /// 활성화 여부
  isActive        Boolean  @default(true) @map("is_active")
  /// 생성일시
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// 수정일시
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  /// 재고 거래 내역들
  transactions InventoryTransaction[]

  @@index([category, isActive])
  @@map("inventory_items")
}

/// 재고 거래 내역 (입고, 출고, 조정)
model InventoryTransaction {
  /// 거래 ID (Primary Key)
  id          BigInt   @id @default(autoincrement())
  /// 품목 ID (외래키)
  itemId      BigInt   @map("item_id")
  /// 거래일
  txnDate     DateTime @map("txn_date") @db.Date
  /// 거래 유형 (IN, OUT, ADJUST)
  txnType     String   @map("txn_type")
  /// 수량 (입고는 +, 출고는 -)
  quantity    Decimal  @db.Decimal(10, 2)
  /// 단가
  unitPrice   Decimal? @map("unit_price") @db.Decimal(14, 2)
  /// 총 금액
  totalAmount Decimal? @map("total_amount") @db.Decimal(14, 2)
  /// 거래처 ID (외래키)
  supplierId  BigInt?  @map("supplier_id")
  /// 참조 번호
  referenceNo String?  @map("reference_no")
  /// 비고
  notes       String?
  /// 생성자 ID (외래키)
  createdBy   BigInt?  @map("created_by")
  /// 생성일시
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 품목
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 거래처
  supplier Supplier?     @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  /// 생성자
  creator  Employee?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([itemId, txnDate(sort: Desc)])
  @@map("inventory_transactions")
}

/// 차량 정보
model Vehicle {
  /// 차량 ID (Primary Key)
  id               BigInt    @id @default(autoincrement())
  /// 차량 번호 (고유값)
  vehicleNo        String    @unique @map("vehicle_no")
  /// 차량 종류 (승용, 승합 등)
  vehicleType      String    @map("vehicle_type")
  /// 모델명
  model            String?
  /// 제조사
  manufacturer     String?
  /// 연식
  year             Int?
  /// 정원
  capacity         Int?
  /// 구매일
  purchaseDate     DateTime? @map("purchase_date") @db.Date
  /// 마지막 점검일
  lastInspection   DateTime? @map("last_inspection") @db.Date
  /// 보험 만료일
  insuranceExpires DateTime? @map("insurance_expires") @db.Date
  /// 주행거리 (km)
  mileage          Int?
  /// 상태 (ACTIVE, INACTIVE, MAINTENANCE)
  status           String    @default("ACTIVE")
  /// 비고
  notes            String?
  /// 생성일시
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// 수정일시
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// 운송 요청들
  requests TransportRequest[]

  @@map("vehicles")
}

/// 운송 요청 (통원, 외출 등)
model TransportRequest {
  /// 요청 ID (Primary Key)
  id              BigInt    @id @default(autoincrement())
  /// 입소자 ID (외래키)
  residentId      BigInt    @map("resident_id")
  /// 차량 ID (외래키)
  vehicleId       BigInt?   @map("vehicle_id")
  /// 운전기사 ID (외래키)
  driverId        BigInt?   @map("driver_id")
  /// 요청 일시
  requestDate     DateTime  @map("request_date") @db.Timestamptz
  /// 출발지
  pickupLocation  String    @map("pickup_location")
  /// 목적지
  destination     String
  /// 목적
  purpose         String?
  /// 상태 (PENDING, APPROVED, COMPLETED, CANCELLED)
  status          String    @default("PENDING")
  /// 실제 출발 시각
  actualDeparture DateTime? @map("actual_departure") @db.Timestamptz
  /// 실제 도착 시각
  actualArrival   DateTime? @map("actual_arrival") @db.Timestamptz
  /// 비고
  notes           String?
  /// 생성자 ID (외래키)
  createdBy       BigInt?   @map("created_by")
  /// 생성일시
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// 수정일시
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// 입소자
  resident Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade)
  /// 차량
  vehicle  Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// 운전기사
  driver   Employee? @relation("TransportDriver", fields: [driverId], references: [id], onDelete: SetNull)
  /// 요청 생성자
  creator  Employee? @relation("TransportCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([requestDate(sort: Desc)])
  @@map("transport_requests")
}

/// CCTV 장비 정보
model CctvDevice {
  /// 장비 ID (Primary Key)
  id            BigInt    @id @default(autoincrement())
  /// 장비 번호 (고유값)
  deviceNo      String    @unique @map("device_no")
  /// 설치 위치
  location      String
  /// IP 주소
  ipAddress     String?   @map("ip_address")
  /// 모델명
  model         String?
  /// 설치일
  installDate   DateTime? @map("install_date") @db.Date
  /// 마지막 점검일
  lastCheckDate DateTime? @map("last_check_date") @db.Date
  /// 상태 (ACTIVE, INACTIVE, MALFUNCTION)
  status        String    @default("ACTIVE")
  /// 비고
  notes         String?
  /// 생성일시
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// 수정일시
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// CCTV 조회 기록들
  logs CctvViewLog[]

  @@map("cctv_devices")
}

/// CCTV 조회 로그
model CctvViewLog {
  /// 로그 ID (Primary Key)
  id         BigInt    @id @default(autoincrement())
  /// 장비 ID (외래키)
  deviceId   BigInt    @map("device_id")
  /// 조회자 ID (외래키)
  viewerId   BigInt    @map("viewer_id")
  /// 조회 시작 시각
  viewStart  DateTime  @map("view_start") @db.Timestamptz
  /// 조회 종료 시각
  viewEnd    DateTime? @map("view_end") @db.Timestamptz
  /// 조회 목적
  purpose    String
  /// 승인자 ID (외래키)
  approvedBy BigInt?   @map("approved_by")
  /// 생성일시
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// CCTV 장비
  device   CctvDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// 조회자
  viewer   Employee   @relation("CctvViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  /// 승인자
  approver Employee?  @relation("CctvApprover", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([deviceId, viewStart(sort: Desc)])
  @@index([viewerId, viewStart(sort: Desc)])
  @@map("cctv_view_logs")
}

/// 민원 접수 및 처리
model Grievance {
  /// 민원 ID (Primary Key)
  id                  BigInt    @id @default(autoincrement())
  /// 민원 번호 (고유값)
  grievanceNo         String    @unique @map("grievance_no")
  /// 민원인 이름
  complainantName     String    @map("complainant_name")
  /// 민원인 연락처
  complainantPhone    String?   @map("complainant_phone")
  /// 민원인과의 관계
  complainantRelation String?   @map("complainant_relation")
  /// 입소자 ID (외래키)
  residentId          BigInt?   @map("resident_id")
  /// 민원 카테고리 (서비스, 시설, 직원 등)
  category            String
  /// 민원 제목
  title               String
  /// 민원 내용
  content             String
  /// 접수일시
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz
  /// 접수 방법 (전화, 방문, 온라인 등)
  receivedMethod      String?   @map("received_method")
  /// 담당자 ID (외래키)
  assignedTo          BigInt?   @map("assigned_to")
  /// 처리 상태 (RECEIVED, IN_PROGRESS, RESOLVED, CLOSED)
  status              String    @default("RECEIVED")
  /// 답변 내용
  response            String?
  /// 해결일시
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz
  /// 생성일시
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// 수정일시
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// 관련 입소자
  resident Resident? @relation(fields: [residentId], references: [id], onDelete: SetNull)
  /// 담당자
  assignee Employee? @relation("GrievanceAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([status, receivedAt(sort: Desc)])
  @@map("grievances")
}

/// 시설 점검 기록
model FacilityInspection {
  /// 점검 ID (Primary Key)
  id                 BigInt    @id @default(autoincrement())
  /// 점검일
  inspectionDate     DateTime  @map("inspection_date") @db.Date
  /// 점검 유형 (정기, 비정기, 안전, 위생 등)
  inspectionType     String    @map("inspection_type")
  /// 점검자 ID (외래키)
  inspectorId        BigInt?   @map("inspector_id")
  /// 점검 장소
  location           String?
  /// 점검 항목 (JSON)
  checklist          Json?     @db.JsonB
  /// 발견 사항
  findings           String?
  /// 시정 조치
  correctiveActions  String?   @map("corrective_actions")
  /// 상태 (PENDING, COMPLETED)
  status             String    @default("PENDING")
  /// 다음 점검 예정일
  nextInspectionDate DateTime? @map("next_inspection_date") @db.Date
  /// 생성일시
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  /// 수정일시
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  /// 점검자
  inspector Employee? @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)

  @@index([inspectionDate(sort: Desc)])
  @@map("facility_inspections")
}

/// SMS 발송 로그
model SmsSendLog {
  /// 로그 ID (Primary Key)
  id             BigInt    @id @default(autoincrement())
  /// 수신자 전화번호
  recipientPhone String    @map("recipient_phone")
  /// 수신자 이름
  recipientName  String?   @map("recipient_name")
  /// 메시지 내용
  message        String
  /// 발송 유형 (SINGLE, BULK, SCHEDULED)
  sendType       String    @map("send_type")
  /// 예약 발송 시각
  scheduledAt    DateTime? @map("scheduled_at") @db.Timestamptz
  /// 실제 발송 시각
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  /// 발송 상태 (PENDING, SUCCESS, FAILED)
  status         String    @default("PENDING")
  /// 오류 메시지
  errorMessage   String?   @map("error_message")
  /// SMS 건수 (장문 시 2건 이상)
  smsCount       Int       @default(1) @map("sms_count")
  /// 발송 비용
  cost           Decimal?  @db.Decimal(10, 2)
  /// 결과 코드
  resultCode     String?   @map("result_code")
  /// 발송자 ID (외래키)
  senderId       BigInt?   @map("sender_id")
  /// 생성일시
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  /// 발송자
  sender Employee? @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt(sort: Desc)])
  @@index([sentAt(sort: Desc)])
  @@map("sms_send_logs")
}

// ============================================
// 9. 공통 파일 / 로그 / 설정 / 알림 큐 (4 Tables)
// ============================================

/// 파일 저장소 (S3, 로컬 등)
model FileStorage {
  /// 파일 ID (Primary Key)
  id           BigInt   @id @default(autoincrement())
  /// 저장소 버킷
  bucket       String   @default("default")
  /// 파일 경로
  path         String
  /// 원본 파일명
  originalName String?  @map("original_name")
  /// MIME 타입
  mimeType     String?  @map("mime_type")
  /// 파일 크기 (바이트)
  sizeBytes    BigInt?  @map("size_bytes")
  /// 체크섬 (MD5, SHA256 등)
  checksum     String?
  /// 업로드자 ID (외래키)
  createdBy    BigInt?  @map("created_by")
  /// 생성일시
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 업로드자
  creator           Employee?          @relation("FileCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  /// 상담 첨부 파일 연결
  consultationFiles ConsultationFile[] @relation("ConsultationFiles")
  /// 사건 첨부 파일 연결
  incidentFiles     IncidentFile[]     @relation("IncidentFiles")
  /// 공지 첨부 파일 연결
  noticeFiles       NoticeFile[]       @relation("NoticeFiles")
  /// 게시판 첨부 파일 연결
  boardFiles        BoardFile[]        @relation("BoardFiles")
  /// 갤러리 파일 연결
  galleryFiles      GalleryFile[]      @relation("GalleryFiles")

  @@unique([bucket, path])
  @@map("file_storage")
}

/// ===============================
/// 감사 로그 (Audit Log)
/// - 시스템 내 모든 주요 변경 이력을 기록
/// - 누가(actor) 언제 무엇을(action) 어떤 엔티티에 대해 수행했는지 추적
/// ===============================
model AuditLog {
  /// 로그 ID (Primary Key)
  id BigInt @id @default(autoincrement())

  /// 작업을 수행한 사용자 ID (Employee.id 참조)
  /// 시스템 작업일 경우 NULL 가능
  actorId BigInt? @map("actor_id")

  /// 수행된 작업 유형
  /// 예: CREATE, UPDATE, DELETE, LOGIN 등
  action String

  /// 변경 대상 엔티티 타입 (테이블명 또는 도메인명)
  /// 예: Employee, Reservation, Payment
  entityType String? @map("entity_type")

  /// 변경 대상 엔티티의 ID
  entityId BigInt? @map("entity_id")

  /// 변경 내용 (이전/이후 값 등)
  /// 구조는 서비스 로직에서 자유롭게 정의
  changes Json? @db.JsonB

  /// 요청 발생 IP 주소
  ipAddress String? @map("ip_address")

  /// 사용자 브라우저 / 디바이스 정보
  userAgent String? @map("user_agent")

  /// 로그 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 작업 수행자와의 관계
  /// 사용자가 삭제되어도 로그는 유지
  actor Employee? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// 특정 엔티티에 대한 로그 조회 최적화
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// ===============================
/// 시스템 설정 (Key-Value 기반)
/// - 운영 중 변경 가능한 설정값 저장
/// - 캐시 or 관리자 페이지에서 주로 사용
/// ===============================
model SystemSetting {
  /// 설정 키 (Primary Key)
  /// 예: "MAX_RESERVATION_COUNT", "ENABLE_SMS"
  key String @id

  /// 설정 값 (JSON 형태)
  /// 숫자, 문자열, 객체 등 유연하게 저장 가능
  value Json @db.JsonB

  /// 설정에 대한 설명
  description String?

  /// 마지막 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("system_settings")
}

/// ===============================
/// 알림 발송 큐
/// - 이메일, SMS, 푸시 알림 등 비동기 발송 관리
/// - 실패/재시도 처리에 활용
/// ===============================
model NotificationQueue {
  /// 알림 ID (Primary Key)
  id BigInt @id @default(autoincrement())

  /// 발송 채널
  /// 예: EMAIL, SMS, PUSH
  channel String

  /// 알림 대상 타입
  /// 예: EMPLOYEE, USER, ADMIN
  targetType String @map("target_type")

  /// 알림 대상 ID
  targetId BigInt? @map("target_id")

  /// 알림 제목
  title String?

  /// 알림 본문
  body String?

  /// 채널별 추가 데이터
  /// 예: 템플릿 변수, 딥링크 정보
  payload Json @default("{}") @db.JsonB

  /// 발송 예정 시각
  scheduledAt DateTime @default(now()) @map("scheduled_at") @db.Timestamptz

  /// 실제 발송 완료 시각
  sentAt DateTime? @map("sent_at") @db.Timestamptz

  /// 발송 상태
  /// PENDING, SENT, FAILED
  status String @default("PENDING")

  /// 발송 실패 시 에러 메시지
  errorMessage String? @map("error_message")

  /// 큐에 등록된 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 상태 + 예약시간 기준 조회 최적화
  @@index([status, scheduledAt])
  @@map("notification_queue")
}

/// ===============================
/// 면회 예약
/// - 홈페이지 면회 예약 신청 관리
/// ===============================
model VisitReservation {
  /// 예약 ID (Primary Key)
  id BigInt @id @default(autoincrement())

  /// 방문자 성함
  visitorName String @map("visitor_name")

  /// 방문자 연락처
  visitorPhone String @map("visitor_phone")

  /// 어르신과의 관계
  visitorRelationship String @map("visitor_relationship")

  /// 어르신 성함
  residentName String @map("resident_name")

  /// 방문 희망일
  visitDate DateTime @map("visit_date") @db.Date

  /// 방문 희망시간
  visitTime String @map("visit_time")

  /// 방문 인원
  visitorCount Int @default(1) @map("visitor_count")

  /// 방문 목적
  visitPurpose String? @map("visit_purpose")

  /// 감염 증상 여부 (발열, 기침 등)
  healthCheckSymptoms Boolean @default(false) @map("health_check_symptoms")

  /// 이동 보조 필요 여부
  healthCheckAssistance Boolean @default(false) @map("health_check_assistance")

  /// 추가 요청사항
  notes String?

  /// 개인정보 수집 동의 여부
  isConsented Boolean @default(false) @map("is_consented")

  /// 처리 상태 (PENDING, APPROVED, REJECTED, CANCELLED)
  status String @default("PENDING")

  /// 신청 IP 주소
  ipAddress String? @map("ip_address")

  /// 사용자 브라우저 정보
  userAgent String? @map("user_agent")

  /// 신청 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("visit_reservations")
}

/// ===============================
/// 웹사이트 상담 문의
/// - 홈페이지 상담 신청 접수용
/// - 관리자 페이지에서 처리 상태 관리
/// ===============================
model WebInquiry {
  /// 문의 ID (Primary Key)
  id BigInt @id @default(autoincrement())

  /// 상담자 이름
  name String

  /// 상담자 연락처
  phone String

  /// 이메일
  email String?

  /// 문의 유형
  /// 입소 상담, 비용 상담, 방문 상담, 기타
  type String

  /// 어르신 연령
  residentAge String? @map("resident_age")

  /// 장기요양등급
  careGrade String? @map("care_grade")

  /// 방문 상담 희망일
  preferredDate DateTime? @map("preferred_date") @db.Date

  /// 상세 문의사항
  message String?

  /// 개인정보 수집 동의 여부
  isConsented Boolean @default(false) @map("is_consented")

  /// 처리 상태
  /// PENDING: 접수, IN_PROGRESS: 상담중, DONE: 완료, CANCELLED: 취소
  status String @default("PENDING")

  /// 문의 접수 IP 주소
  ipAddress String? @map("ip_address")

  /// 사용자 브라우저 정보
  userAgent String? @map("user_agent")

  /// 문의 생성 시각
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// 수정 시각
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("web_inquiries")
}
