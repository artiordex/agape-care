  @@map("account_categories")
}

/// 계정 과목
model Account {
  /// 계정 과목 ID (Primary Key)
  id          BigInt   @id @default(autoincrement())
  /// 분류 ID (외래키)
  categoryId  BigInt?  @map("category_id")
  /// 계정 과목 코드 (고유값)
  code        String   @unique
  /// 계정 과목명
