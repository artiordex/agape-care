model LeaveApproval {
  /// 승인 내역 ID (Primary Key)
  id             BigInt       @id @default(autoincrement())
  /// 휴가 신청 ID (외래키)
  leaveRequestId BigInt       @map("leave_request_id")
  /// 승인자 ID (외래키)
  approvedBy     BigInt?      @map("approved_by")
  /// 승인일시
  approvedAt     DateTime?    @map("approved_at") @db.Timestamptz(6)
  /// 승인 결정 (APPROVED, REJECTED)
  decision       String
  /// 승인 의견
  comment        String?
  /// 생성일시
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  approver       Employee?    @relation(fields: [approvedBy], references: [id], onUpdate: NoAction)
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("leave_approvals")
}

/// 계정 과목 분류
model AccountCategory {
  /// 분류 ID (Primary Key)
  id        BigInt    @id @default(autoincrement())
  /// 분류 코드 (고유값)
  code      String    @unique
  /// 분류명
  name      String
  /// 종류 (자산, 부채, 자본, 수익, 비용)
  kind      String
  /// 생성일시
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  accounts  Account[]

  @@map("account_categories")
}

/// 계정 과목
model Account {
  /// 계정 과목 ID (Primary Key)
  id          BigInt            @id @default(autoincrement())
  /// 분류 ID (외래키)
  categoryId  BigInt?           @map("category_id")
  /// 계정 과목 코드 (고유값)
  code        String            @unique
  /// 계정 과목명
  name        String
  /// 설명
  description String?
  /// 활성화 여부
  isActive    Boolean           @default(true) @map("is_active")
  /// 생성일시
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    AccountCategory?  @relation(fields: [categoryId], references: [id], onUpdate: NoAction)
  items       TransactionItem[]

  @@map("accounts")
}

/// 거래처 (공급업체)
model Supplier {
  /// 거래처 ID (Primary Key)
  id                    BigInt                 @id @default(autoincrement())
  /// 거래처명
  name                  String
  /// 사업자 번호
  businessNo            String?                @map("business_no")
  /// 전화번호
  phoneNumber           String?                @map("phone_number")
  /// 이메일
  email                 String?                @db.Citext
  /// 주소
  address               String?
  /// 메모
  memo                  String?
  /// 생성일시
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt             DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryTransactions InventoryTransaction[]
  transactions          Transaction[]

  @@map("suppliers")
}

/// 회계 거래 (전표)
model Transaction {
  /// 거래 ID (Primary Key)
  id          BigInt            @id @default(autoincrement())
  /// 거래일
  txnDate     DateTime          @map("txn_date") @db.Date
  /// 적요 (거래 설명)
  description String?
  /// 참조 번호 (증빙 번호 등)
  referenceNo String?           @map("reference_no")
  /// 거래처 ID (외래키)
  supplierId  BigInt?           @map("supplier_id")
  /// 생성자 ID (외래키)
  createdBy   BigInt?           @map("created_by")
  /// 총 금액
  totalAmount Decimal           @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 통화 (KRW, USD 등)
  currency    String            @default("KRW")
  /// 생성일시
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items       TransactionItem[]
  creator     Employee?         @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  supplier    Supplier?         @relation(fields: [supplierId], references: [id], onUpdate: NoAction)

  @@index([txnDate(sort: Desc)], map: "idx_transactions_date")
  @@index([supplierId], map: "idx_transactions_supplier")
  @@map("transactions")
}

/// 회계 거래 항목 (분개)
model TransactionItem {
  /// 항목 ID (Primary Key)
  id            BigInt      @id @default(autoincrement())
  /// 거래 ID (외래키)
  transactionId BigInt      @map("transaction_id")
  /// 계정 과목 ID (외래키)
  accountId     BigInt      @map("account_id")
  /// 라인 번호
  lineNo        Int         @map("line_no")
  /// 적요
  description   String?
  /// 차변 금액
  debitAmount   Decimal     @default(0) @map("debit_amount") @db.Decimal(14, 2)
  /// 대변 금액
  creditAmount  Decimal     @default(0) @map("credit_amount") @db.Decimal(14, 2)
  /// 생성일시
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  account       Account     @relation(fields: [accountId], references: [id], onUpdate: NoAction)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([transactionId, lineNo], map: "transaction_items_line_uniq")
  @@index([accountId], map: "idx_transaction_items_account")
  @@map("transaction_items")
}

/// 급여 지급 내역
model PayrollRecord {
  /// 급여 내역 ID (Primary Key)
  id             BigInt        @id @default(autoincrement())
  /// 직원 ID (외래키)
  employeeId     BigInt        @map("employee_id")
  /// 급여 기간 시작일
  periodStart    DateTime      @map("period_start") @db.Date
  /// 급여 기간 종료일
  periodEnd      DateTime      @map("period_end") @db.Date
  /// 기본급
  baseSalary     Decimal       @default(0) @map("base_salary") @db.Decimal(14, 2)
  /// 수당 합계
  totalAllowance Decimal       @default(0) @map("total_allowance") @db.Decimal(14, 2)
  /// 공제 합계
  totalDeduction Decimal       @default(0) @map("total_deduction") @db.Decimal(14, 2)
  /// 실 수령액
  netPay         Decimal       @default(0) @map("net_pay") @db.Decimal(14, 2)
  /// 지급일시
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  /// 상태 (PENDING, PAID)
  status         String        @default("PENDING")
  /// 생성일시
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items          PayrollItem[]
  employee       Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([periodStart, periodEnd], map: "idx_payroll_records_period")
  @@index([status], map: "idx_payroll_records_status")
  @@map("payroll_records")
}

/// 급여 세부 항목 (수당, 공제 등)
model PayrollItem {
  /// 항목 ID (Primary Key)
  id        BigInt        @id @default(autoincrement())
  /// 급여 내역 ID (외래키)
  payrollId BigInt        @map("payroll_id")
  /// 항목 종류 (ALLOWANCE, DEDUCTION)
  kind      String
  /// 항목명 (야간수당, 국민연금 등)
  name      String
  /// 금액
  amount    Decimal       @db.Decimal(14, 2)
  /// 생성일시
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  payroll   PayrollRecord @relation(fields: [payrollId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("payroll_items")
}

/// 청구서 헤더
model InvoiceHeader {
  /// 청구서 ID (Primary Key)
  id          BigInt        @id @default(autoincrement())
  /// 청구서 번호 (고유값)
  invoiceNo   String        @unique @map("invoice_no")
  /// 입소자 ID (외래키)
  residentId  BigInt?       @map("resident_id")
  /// 발행일
  issueDate   DateTime      @map("issue_date") @db.Date
  /// 납기일
  dueDate     DateTime?     @map("due_date") @db.Date
  /// 총 금액
  totalAmount Decimal       @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 상태 (DRAFT, ISSUED, PAID, CANCELLED)
  status      String        @default("DRAFT")
  /// 생성일시
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  resident    Resident?     @relation(fields: [residentId], references: [id], onUpdate: NoAction)
  items       InvoiceItem[]

  @@map("invoice_headers")
}

/// 청구서 항목
model InvoiceItem {
  /// 항목 ID (Primary Key)
  id          BigInt        @id @default(autoincrement())
  /// 청구서 ID (외래키)
  invoiceId   BigInt        @map("invoice_id")
  /// 라인 번호
  lineNo      Int           @map("line_no")
  /// 항목 설명
  description String
  /// 수량
  quantity    Decimal       @default(1) @db.Decimal(10, 2)
  /// 단가
  unitPrice   Decimal       @default(0) @map("unit_price") @db.Decimal(14, 2)
  /// 금액
  amount      Decimal       @default(0) @db.Decimal(14, 2)
  /// 생성일시
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  invoice     InvoiceHeader @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([invoiceId, lineNo], map: "invoice_items_line_uniq")
  @@map("invoice_items")
}

/// 보험 청구 (장기요양보험 등)
model InsuranceClaim {
  /// 청구 ID (Primary Key)
  id             BigInt                  @id @default(autoincrement())
  /// 청구 번호 (고유값)
  claimNo        String                  @unique @map("claim_no")
  /// 입소자 ID (외래키)
  residentId     BigInt                  @map("resident_id")
  /// 청구 월
  claimMonth     DateTime                @map("claim_month") @db.Date
  /// 청구 유형 (요양급여, 건강보험 등)
  claimType      String                  @map("claim_type")
  /// 청구 총액
  totalAmount    Decimal                 @default(0) @map("total_amount") @db.Decimal(14, 2)
  /// 인정 금액
  approvedAmount Decimal?                @map("approved_amount") @db.Decimal(14, 2)
  /// 제출일시
  submittedAt    DateTime?               @map("submitted_at") @db.Timestamptz(6)
  /// 승인일시
  approvedAt     DateTime?               @map("approved_at") @db.Timestamptz(6)
  /// 지급일시
  paidAt         DateTime?               @map("paid_at") @db.Timestamptz(6)
  /// 상태 (DRAFT, SUBMITTED, APPROVED, REJECTED, PAID)
  status         String                  @default("DRAFT")
  /// 거부 사유
  rejectReason   String?                 @map("reject_reason")
  /// 비고
  notes          String?
  /// 생성자 ID (외래키)
  createdBy      BigInt?                 @map("created_by")
  /// 생성일시
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt      DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  history        InsuranceClaimHistory[]
  items          InsuranceClaimItem[]
  creator        Employee?               @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  resident       Resident                @relation(fields: [residentId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([claimNo], map: "idx_insurance_claims_claim_no")
  @@index([residentId], map: "idx_insurance_claims_resident")
  @@index([residentId, claimMonth(sort: Desc)], map: "idx_insurance_claims_resident_month")
  @@index([status, claimMonth(sort: Desc)], map: "idx_insurance_claims_status")
  @@map("insurance_claims")
}

/// 보험 청구 항목
model InsuranceClaimItem {
  /// 항목 ID (Primary Key)
  id          BigInt         @id @default(autoincrement())
  /// 청구 ID (외래키)
  claimId     BigInt         @map("claim_id")
  /// 서비스 일자
  serviceDate DateTime       @map("service_date") @db.Date
  /// 서비스 코드
  serviceCode String         @map("service_code")
  /// 서비스명
  serviceName String         @map("service_name")
  /// 수량
  quantity    Decimal        @default(1) @db.Decimal(10, 2)
  /// 단가
  unitPrice   Decimal        @default(0) @map("unit_price") @db.Decimal(14, 2)
  /// 금액
  amount      Decimal        @default(0) @db.Decimal(14, 2)
  /// 본인 부담금
  copayAmount Decimal        @default(0) @map("copay_amount") @db.Decimal(14, 2)
  /// 비고
  notes       String?
  /// 생성일시
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  claim       InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([claimId, serviceDate], map: "idx_insurance_claim_items_claim")
  @@map("insurance_claim_items")
}

/// 보험 청구 상태 변경 이력
model InsuranceClaimHistory {
  /// 이력 ID (Primary Key)
  id        BigInt         @id @default(autoincrement())
  /// 청구 ID (외래키)
  claimId   BigInt         @map("claim_id")
  /// 변경된 상태
  status    String
  /// 변경자 ID (외래키)
  changedBy BigInt?        @map("changed_by")
  /// 변경 의견
  comment   String?
  /// 생성일시
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  changer   Employee?      @relation(fields: [changedBy], references: [id], onUpdate: NoAction)
  claim     InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([claimId, createdAt(sort: Desc)], map: "idx_insurance_claim_history_claim")
  @@map("insurance_claim_history")
}

/// 재고 품목
model InventoryItem {
  /// 품목 ID (Primary Key)
  id              BigInt                 @id @default(autoincrement())
  /// 품목 코드 (고유값)
  code            String                 @unique
  /// 품목명
  name            String
  /// 카테고리 (의약품, 소모품, 식자재 등)
  category        String
  /// 단위 (개, 박스, kg 등)
  unit            String
  /// 현재 재고량
  currentStock    Decimal                @default(0) @map("current_stock") @db.Decimal(10, 2)
  /// 최소 재고량
  minStock        Decimal?               @map("min_stock") @db.Decimal(10, 2)
  /// 최대 재고량
  maxStock        Decimal?               @map("max_stock") @db.Decimal(10, 2)
  /// 단가
  unitPrice       Decimal?               @map("unit_price") @db.Decimal(14, 2)
  /// 보관 위치
  storageLocation String?                @map("storage_location")
  /// 활성화 여부
  isActive        Boolean                @default(true) @map("is_active")
  /// 생성일시
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt       DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  transactions    InventoryTransaction[]

  @@index([isActive], map: "idx_inventory_items_active")
  @@index([category, isActive], map: "idx_inventory_items_category")
  @@map("inventory_items")
}

/// 재고 거래 내역 (입고, 출고, 조정)
model InventoryTransaction {
  /// 거래 ID (Primary Key)
  id          BigInt        @id @default(autoincrement())
  /// 품목 ID (외래키)
  itemId      BigInt        @map("item_id")
  /// 거래일
  txnDate     DateTime      @map("txn_date") @db.Date
  /// 거래 유형 (IN, OUT, ADJUST)
  txnType     String        @map("txn_type")
  /// 수량 (입고는 +, 출고는 -)
  quantity    Decimal       @db.Decimal(10, 2)
  /// 단가
  unitPrice   Decimal?      @map("unit_price") @db.Decimal(14, 2)
  /// 총 금액
  totalAmount Decimal?      @map("total_amount") @db.Decimal(14, 2)
  /// 거래처 ID (외래키)
  supplierId  BigInt?       @map("supplier_id")
  /// 참조 번호
  referenceNo String?       @map("reference_no")
  /// 비고
  notes       String?
  /// 생성자 ID (외래키)
  createdBy   BigInt?       @map("created_by")
  /// 생성일시
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  creator     Employee?     @relation(fields: [createdBy], references: [id], onUpdate: NoAction)
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  supplier    Supplier?     @relation(fields: [supplierId], references: [id], onUpdate: NoAction)

  @@index([txnDate(sort: Desc)], map: "idx_inventory_transactions_date")
  @@index([itemId, txnDate(sort: Desc)], map: "idx_inventory_transactions_item_date")
  @@map("inventory_transactions")
}

/// 차량 정보
model Vehicle {
  /// 차량 ID (Primary Key)
  id               BigInt             @id @default(autoincrement())
  /// 차량 번호 (고유값)
  vehicleNo        String             @unique @map("vehicle_no")
  /// 차량 종류 (승용, 승합 등)
  vehicleType      String             @map("vehicle_type")
  /// 모델명
  model            String?
  /// 제조사
  manufacturer     String?
  /// 연식
  year             Int?
  /// 정원
  capacity         Int?
  /// 구매일
  purchaseDate     DateTime?          @map("purchase_date") @db.Date
  /// 마지막 점검일
  lastInspection   DateTime?          @map("last_inspection") @db.Date
  /// 보험 만료일
  insuranceExpires DateTime?          @map("insurance_expires") @db.Date
  /// 주행거리 (km)
  mileage          Int?
  /// 상태 (ACTIVE, INACTIVE, MAINTENANCE)
  status           String             @default("ACTIVE")
  /// 비고
  notes            String?
  /// 생성일시
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  requests         TransportRequest[]

  @@index([vehicleNo], map: "idx_vehicles_no")
  @@index([status], map: "idx_vehicles_status")
  @@map("vehicles")
}

/// 운송 요청 (통원, 외출 등)
model TransportRequest {
  /// 요청 ID (Primary Key)
  id              BigInt    @id @default(autoincrement())
  /// 입소자 ID (외래키)
  residentId      BigInt    @map("resident_id")
  /// 차량 ID (외래키)
  vehicleId       BigInt?   @map("vehicle_id")
  /// 운전기사 ID (외래키)
  driverId        BigInt?   @map("driver_id")
  /// 요청 일시
  requestDate     DateTime  @map("request_date") @db.Timestamptz(6)
  /// 출발지
  pickupLocation  String    @map("pickup_location")
  /// 목적지
  destination     String
  /// 목적
  purpose         String?
  /// 상태 (PENDING, APPROVED, COMPLETED, CANCELLED)
  status          String    @default("PENDING")
  /// 실제 출발 시각
  actualDeparture DateTime? @map("actual_departure") @db.Timestamptz(6)
  /// 실제 도착 시각
  actualArrival   DateTime? @map("actual_arrival") @db.Timestamptz(6)
  /// 비고
  notes           String?
  /// 생성자 ID (외래키)
  createdBy       BigInt?   @map("created_by")
  /// 생성일시
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator         Employee? @relation("TransportCreator", fields: [createdBy], references: [id], onUpdate: NoAction)
  driver          Employee? @relation("TransportDriver", fields: [driverId], references: [id], onUpdate: NoAction)
  resident        Resident  @relation(fields: [residentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onUpdate: NoAction)

  @@index([requestDate(sort: Desc)], map: "idx_transport_requests_date")
  @@index([residentId], map: "idx_transport_requests_resident")
  @@map("transport_requests")
}

/// CCTV 장비 정보
model CctvDevice {
  /// 장비 ID (Primary Key)
  id            BigInt        @id @default(autoincrement())
  /// 장비 번호 (고유값)
  deviceNo      String        @unique @map("device_no")
  /// 설치 위치
  location      String
  /// IP 주소
  ipAddress     String?       @map("ip_address")
  /// 모델명
  model         String?
  /// 설치일
  installDate   DateTime?     @map("install_date") @db.Date
  /// 마지막 점검일
  lastCheckDate DateTime?     @map("last_check_date") @db.Date
  /// 상태 (ACTIVE, INACTIVE, MALFUNCTION)
  status        String        @default("ACTIVE")
  /// 비고
  notes         String?
  /// 생성일시
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt     DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  logs          CctvViewLog[]

  @@index([status], map: "idx_cctv_devices_status")
  @@map("cctv_devices")
}

/// CCTV 조회 로그
model CctvViewLog {
  /// 로그 ID (Primary Key)
  id         BigInt     @id @default(autoincrement())
  /// 장비 ID (외래키)
  deviceId   BigInt     @map("device_id")
  /// 조회자 ID (외래키)
  viewerId   BigInt     @map("viewer_id")
  /// 조회 시작 시각
  viewStart  DateTime   @map("view_start") @db.Timestamptz(6)
  /// 조회 종료 시각
  viewEnd    DateTime?  @map("view_end") @db.Timestamptz(6)
  /// 조회 목적
  purpose    String
  /// 승인자 ID (외래키)
  approvedBy BigInt?    @map("approved_by")
  /// 생성일시
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  approver   Employee?  @relation("CctvApprover", fields: [approvedBy], references: [id], onUpdate: NoAction)
  device     CctvDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  viewer     Employee   @relation("CctvViewer", fields: [viewerId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([deviceId, viewStart(sort: Desc)], map: "idx_cctv_view_logs_device_time")
  @@index([viewerId, viewStart(sort: Desc)], map: "idx_cctv_view_logs_viewer")
  @@map("cctv_view_logs")
}

/// 민원 접수 및 처리
model Grievance {
  /// 민원 ID (Primary Key)
  id                  BigInt    @id @default(autoincrement())
  /// 민원 번호 (고유값)
  grievanceNo         String    @unique @map("grievance_no")
  /// 민원인 이름
  complainantName     String    @map("complainant_name")
  /// 민원인 연락처
  complainantPhone    String?   @map("complainant_phone")
  /// 민원인과의 관계
  complainantRelation String?   @map("complainant_relation")
  /// 입소자 ID (외래키)
  residentId          BigInt?   @map("resident_id")
  /// 민원 카테고리 (서비스, 시설, 직원 등)
  category            String
  /// 민원 제목
  title               String
  /// 민원 내용
  content             String
  /// 접수일시
  receivedAt          DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)
  /// 접수 방법 (전화, 방문, 온라인 등)
  receivedMethod      String?   @map("received_method")
  /// 담당자 ID (외래키)
  assignedTo          BigInt?   @map("assigned_to")
  /// 처리 상태 (RECEIVED, IN_PROGRESS, RESOLVED, CLOSED)
  status              String    @default("RECEIVED")
  /// 답변 내용
  response            String?
  /// 해결일시
  resolvedAt          DateTime? @map("resolved_at") @db.Timestamptz(6)
  /// 생성일시
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignee            Employee? @relation("GrievanceAssignee", fields: [assignedTo], references: [id], onUpdate: NoAction)
  resident            Resident? @relation(fields: [residentId], references: [id], onUpdate: NoAction)

  @@index([residentId], map: "idx_grievances_resident")
  @@index([status, receivedAt(sort: Desc)], map: "idx_grievances_status")
  @@index([status, receivedAt(sort: Desc)], map: "idx_grievances_status_received")
  @@map("grievances")
}

/// 시설 점검 기록
model FacilityInspection {
  /// 점검 ID (Primary Key)
  id                 BigInt    @id @default(autoincrement())
  /// 점검일
  inspectionDate     DateTime  @map("inspection_date") @db.Date
  /// 점검 유형 (정기, 비정기, 안전, 위생 등)
  inspectionType     String    @map("inspection_type")
  /// 점검자 ID (외래키)
  inspectorId        BigInt?   @map("inspector_id")
  /// 점검 장소
  location           String?
  /// 점검 항목 (JSON)
  checklist          Json?
  /// 발견 사항
  findings           String?
  /// 시정 조치
  correctiveActions  String?   @map("corrective_actions")
  /// 상태 (PENDING, COMPLETED)
  status             String    @default("PENDING")
  /// 다음 점검 예정일
  nextInspectionDate DateTime? @map("next_inspection_date") @db.Date
  /// 생성일시
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  /// 수정일시
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
