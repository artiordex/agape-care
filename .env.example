# Agape Care environment example
# Copy this file to .env and adjust secrets for your environment.

# ------------------------------------------------------
# Common
# ------------------------------------------------------
NODE_ENV=development
TZ=Asia/Seoul
LOG_LEVEL=info

# ------------------------------------------------------
# Service ports
# ------------------------------------------------------
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=8000
WORKER_PORT=3003
WORKER_METRICS_PORT=3002
NGINX_PORT=80
REDISINSIGHT_PORT=5540
N8N_PORT=5678

# ------------------------------------------------------
# Public/internal URLs
# ------------------------------------------------------
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
API_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
INTERNAL_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# ------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agape_care
POSTGRES_USER=agape
POSTGRES_PASSWORD=agape
DATABASE_URL=postgresql://agape:agape@localhost:5432/agape_care
TEST_DATABASE_URL=postgresql://agape:agape@localhost:5432/agape_care_test

# ------------------------------------------------------
# Redis
# ------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=agape
REDIS_DB=0
REDIS_URL=redis://:agape@localhost:6379/0
QUEUE_REDIS_DB=1
QUEUE_REDIS_URL=redis://:agape@localhost:6379/1
REDIS_MAXMEMORY=256mb
REDIS_EVICTION=allkeys-lru

# ------------------------------------------------------
# Auth / JWT (required by API)
# ------------------------------------------------------
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------
# Worker / notification
# ------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Agape Care" <noreply@agape-care.com>
ADMIN_EMAIL=admin@agape-care.com

# ------------------------------------------------------
# Docker compose / infra
# ------------------------------------------------------
COMPOSE_PROJECT_NAME=agape-care
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# n8n
N8N_DB_NAME=n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_EXECUTIONS_TIMEOUT=3600
N8N_EXECUTIONS_MAX_TIMEOUT=14400

# ------------------------------------------------------
# Optional feature flags
# ------------------------------------------------------
FEATURE_AI_RECOMMENDATIONS=true
FEATURE_PAYMENT_GATEWAY=false
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_SLACK_NOTIFICATIONS=false
FEATURE_ADVANCED_ANALYTICS=false

# ------------------------------------------------------
# Optional external integrations
# ------------------------------------------------------
OPENAI_API_KEY=
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
