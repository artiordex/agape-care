# Description : Dockerfile.web - 📌 Agape Care Web (Next.js)
# Author : Shiwoo Min
# Date : 2026-01-25
# docker build -f infra/docker/Dockerfile.web -t agape-care-web . --progress=plain
# docker build --no-cache -f infra/docker/Dockerfile.web -t agape-care-web .
# Web (포트 3000 매핑)
# docker run -d -p 3000:3000 --name agape-web agape-care-web
# docker run -it --entrypoint sh agape-care-web:latest

# Build Stage
FROM node:22-alpine AS build
WORKDIR /app

# husky 비활성화
ENV HUSKY=0

RUN npm install -g pnpm

# Copy everything
COPY . .

RUN pnpm install --frozen-lockfile

# Explicitly build dependencies to ensure local dist folders are populated
RUN pnpm --filter @agape-care/api-contract build
RUN pnpm --filter @agape-care/ui build
RUN pnpm --filter @agape-care/logger build

# Build web (Next.js standalone)
RUN pnpm nx build @agape-care/web

# Runtime Stage
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# standalone 빌드 결과물 전체 복사
COPY --from=build /app/dist/apps/web/.next/standalone ./

# Next.js static assets
COPY --from=build /app/dist/apps/web/.next/static ./.next/static
COPY --from=build /app/dist/apps/web/.next/static ./apps/web/.next/static

# public 폴더가 비어있을 경우를 대비해 빈 폴더 생성
RUN mkdir -p ./apps/web/public

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
