# Description : Dockerfile.admin - 📌 Agape Care Admin (Next.js Standalone)
# Author : Shiwoo Min
# Date : 2026-01-25
# docker build -f infra/docker/Dockerfile.admin -t agape-care-admin . --progress=plain
# Admin (포트 3001 매핑)
# docker run -d -p 3001:3001 --name agape-admin agape-care-admin

# Build Stage
FROM node:22-alpine AS build
WORKDIR /app

# husky 비활성화
ENV HUSKY=0

RUN npm install -g pnpm

# Copy everything
COPY . .

RUN pnpm install --frozen-lockfile

# Explicitly build dependencies to ensure local dist folders are populated
RUN pnpm --filter @agape-care/api-contract build
RUN pnpm --filter @agape-care/ui build
RUN pnpm --filter @agape-care/logger build

# Build admin (Next.js standalone)
RUN pnpm nx build @agape-care/admin --skip-nx-cache

# Runtime Stage
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

# standalone 빌드 결과물 전체를 복사 (monorepo 구조 유지)
COPY --from=build /app/dist/apps/admin/.next/standalone ./

# Next.js static assets
COPY --from=build /app/dist/apps/admin/.next/static ./.next/static
COPY --from=build /app/dist/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=build /app/dist/apps/admin/.next/static ./dist/apps/admin/.next/static

# Next.js public assets
COPY --from=build /app/apps/admin/public ./apps/admin/public

# public 폴더가 비어있을 경우를 대비해 빈 폴더 생성
RUN mkdir -p ./apps/admin/public

EXPOSE 3001

# monorepo 구조에 맞게 실행
CMD ["node", "apps/admin/server.js"]
