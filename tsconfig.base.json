/**
 * Description : tsconfig.base.json - 📌 Agape-Care 모노레포 루트 TypeScript 설정
 * Author : Shiwoo Min
 * Date : 2026-01-22
 *
 * Supports:
 *  - Next.js 15 (NodeNext)
 *  - Vite / Vitest (브라우저 + Node 혼합 타입)
 *  - NestJS (ESM)
 *  - 모노레포 Workspace 패키지 경로 alias
 */

{
  "compilerOptions": {
    /* 기본 ESM 환경 */
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    /* Node/Vite/Vitest 타입 지원 */
    "types": ["node", "vitest", "vite/client"],

    /* 모듈 호환성 */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    /* Strict 옵션 */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    /* Declaration / SourceMap */
    "declaration": true,
    "sourceMap": true,
    "incremental": true,

    /* 모노레포 Alias */
    "baseUrl": ".",
    "paths": {
      "@agape-care/api-contract": ["packages/api-contract/src/index.ts"],
      "@agape-care/database": ["packages/database/src/index.ts"],
      "@agape-care/logger": ["packages/logger/src/index.ts"],
      "@agape-care/ui": ["packages/ui/src/index.ts"]
    }
  },

  "exclude": ["node_modules", "dist", "build", ".next", "out"]
}
