# Description : .pnpmrc - 📌 PNPM 워크스페이스 패키지 호이스팅 설정 (최종 안정화 버전)
# Author : Shiwoo Min
# Date  : 2025-09-12
# NOTE :
#   - pnpm v10 기준 최적 구성
#   - monorepo + Docker + Nx 환경 안정화
#   - 불필요한 hoist 제거 → 충돌 방지
#   - network 옵션은 Docker-friendly 기준 유지

# 공통 호이스팅 (버전 충돌 위험 없는 패키지들만 hoist)
# 모든 @types/* 패키지들
public-hoist-pattern[]=*@types/*

# TS 컴파일 도구
public-hoist-pattern[]=typescript
public-hoist-pattern[]=ts-node
public-hoist-pattern[]=tsx

# React / Next (모든 앱이 동일 버전 사용하므로 hoist 안전)
public-hoist-pattern[]=react
public-hoist-pattern[]=react-dom
public-hoist-pattern[]=next

# ESLint 관련 패키지
public-hoist-pattern[]=eslint*
public-hoist-pattern[]=prettier

# Vitest / Playwright
public-hoist-pattern[]=vitest
public-hoist-pattern[]=playwright*

# NestJS (선택 사항 – 현재 구조에서는 OK)
public-hoist-pattern[]=@nestjs/*
public-hoist-pattern[]=@agape-care/*

# 공용 유틸리티
public-hoist-pattern[]=zod
public-hoist-pattern[]=dayjs

# 아래 항목들은 hoist 제거 (충돌 가능성 있음) ❗
# public-hoist-pattern[]=tailwindcss
# public-hoist-pattern[]=postcss

# peer dependencies 자동 설치
auto-install-peers=true

# Hoisting / Linking (pnpm v10 권장)
node-linker=hoisted
link-workspace-packages=true
prefer-workspace-packages=true
inject-workspace-packages=true
ignore-workspace-root-check=true

# Docker-friendly 옵션
network-timeout=300000
fetch-timeout=300000
network-concurrency=8
fetch-retries=5
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000

# Cache
registry=https://registry.npmjs.org/
store-dir=.pnpm-store
cache-dir=.pnpm-cache

# Logging / Debug
loglevel=info
progress=true

# 패키지 정책
save-exact=false
audit-level=moderate
fund=false
package-import-method=auto
frozen-lockfile=false  # staging/prod에서는 true 추천
